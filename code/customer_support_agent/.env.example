# ============================================================
# Environment Variables — copy this file to .env and fill in
# your actual values. Never commit .env to version control.
# ============================================================

# ----- OpenAI -----
OPENAI_API_KEY=sk-your-openai-api-key-here

# ----- Model Configuration -----
# Model name to use for the LLM (e.g. gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
MODEL_NAME=gpt-4o-mini

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.3

# Maximum tokens for LLM responses
MAX_TOKENS=512

# ----- Logging -----
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ----- Application -----
APP_NAME=Customer Support AI Assistant
APP_VERSION=1.0.0
